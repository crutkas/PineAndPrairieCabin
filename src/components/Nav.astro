---
import { site } from '../data/site';
import Logo from './Logo.astro';
---
<nav class="nav">
  <a class="brand" href="/" aria-label={site.nameShort}>
    <Logo class="lockup" />
    <Logo variant="mark" class="mark" />
  </a>
  <div class="bar">
    <ul>
      <li><a href="#gallery">Gallery</a></li>
      <li><a href="#story">The Cabin</a></li>
      <li><a href="#amenities">Amenities</a></li>
      <li><a href="#area">The Area</a></li>
    </ul>
    <a class="cta" href="#book">Check Availability</a>
  </div>
</nav>

<style>
  :global(html) { scroll-padding-top: 150px; }
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; flex-direction: column; align-items: center;
    gap: 14px;
    padding: 20px 48px 14px;
    background: rgba(250, 248, 245, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(28,28,28,0.06);
  }
  .nav .brand { display: block; line-height: 0; }
  .nav .brand :global(.lockup) { height: 58px; width: auto; max-width: calc(100vw - 48px); }
  .nav .brand :global(.mark) { display: none; height: 34px; width: auto; }
  .nav .bar {
    display: flex; align-items: center; justify-content: center; gap: 40px;
    width: 100%; max-width: 1100px;
    padding-top: 12px;
    border-top: 1px solid rgba(28,28,28,0.08);
  }
  .nav ul {
    display: flex; gap: 36px;
    list-style: none; margin: 0; padding: 0;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 400;
  }
  .nav ul a, .nav .cta { white-space: nowrap; }
  .nav ul a { text-decoration: none; color: var(--ink-soft); transition: color 200ms ease; }
  .nav ul a:hover { color: var(--ink); }
  .nav .cta {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--light-ink);
    background: var(--ink);
    padding: 10px 20px;
    transition: background 200ms ease;
  }
  .nav .cta:hover { background: var(--forest); }

  @media (max-width: 820px) {
    :global(html) { scroll-padding-top: 130px; }
    .nav { padding: 14px 20px 12px; gap: 10px; }
    .nav .brand :global(.lockup) { height: 40px; }
    .nav .bar { gap: 20px; padding-top: 10px; }
    .nav ul { gap: 20px; font-size: 11px; letter-spacing: 0.14em; }
  }
  @media (max-width: 640px) {
    .nav ul { display: none; }
  }
  @media (max-width: 380px) {
    .nav .brand :global(.lockup) { display: none; }
    .nav .brand :global(.mark) { display: block; }
  }
</style>
