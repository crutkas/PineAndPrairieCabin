---
import { site } from '../data/site';
import { heroImage } from '../data/gallery';
---
<header class="hero" style={`background-image: url('${heroImage}');`}>
  <div class="hero-overlay"></div>
  <div class="hero-inner">
    <div class="eyebrow hero-eyebrow">{site.location}</div>
    <h1 class="display"><span>Pine &amp;</span> <em>Prairie</em></h1>
    <p class="sub">{site.tagline}</p>
    <div class="actions">
      <a class="btn light" href="#book">Check Availability</a>
      <a class="btn ghost-light" href="#gallery">View the Cabin</a>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    height: 100vh; min-height: 720px;
    display: flex; align-items: flex-end;
    color: var(--light-ink);
    overflow: hidden;
    background-size: cover;
    background-position: center;
    background-color: var(--ink);
  }
  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.18) 0%, rgba(0,0,0,0.05) 35%, rgba(0,0,0,0.55) 100%);
  }
  .hero-inner {
    position: relative; z-index: 2;
    padding: 0 64px 88px;
    max-width: 1200px;
  }
  .hero-eyebrow { opacity: 0.92; margin-bottom: 24px; }
  .hero h1 {
    font-family: var(--display);
    font-weight: 300;
    font-size: clamp(64px, 9vw, 124px);
    line-height: 0.95;
    letter-spacing: -0.01em;
    margin: 0 0 24px;
    color: var(--light-ink);
  }
  .hero h1 em { font-style: italic; font-weight: 300; }
  .hero h1 span { display: inline; }
  .hero p.sub {
    font-family: var(--display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.3;
    max-width: 620px;
    margin: 0 0 40px;
    opacity: 0.96;
  }
  .hero .actions { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; }

  @media (max-width: 880px) {
    .hero-inner { padding: 0 28px 64px; }
  }
</style>
