---
/**
 * Minimal line-icon set used by amenities. Stroke-based, single color via currentColor.
 * Add new icons as needed — keep them simple and at 24x24 viewBox.
 */
interface Props {
  name: string;
  size?: number;
}
const { name, size = 16 } = Astro.props;
const s = String(size);
---
<svg width={s} height={s} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'flame' && (
    <path d="M12 2c0 4 5 6 5 11a5 5 0 1 1-10 0c0-3 2-4 2-7 0 2 3 3 3-4z" />
  )}
  {name === 'pot' && (
    <>
      <path d="M5 10h14M5 10v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-8" />
      <path d="M9 6V4M15 6V4M3 10h18" />
    </>
  )}
  {name === 'house' && (
    <path d="M3 12l9-9 9 9M5 10v10h14V10" />
  )}
  {name === 'chairs' && (
    <path d="M5 21V10a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v11M13 21V10a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v11M5 14h6M13 14h6" />
  )}
  {name === 'tub' && (
    <>
      <path d="M3 12h18v4a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3v-4z" />
      <path d="M7 12V6a2 2 0 0 1 2-2h1" />
      <circle cx="11" cy="6" r="1.5" />
    </>
  )}
  {name === 'deck' && (
    <>
      <path d="M3 17h18M5 17v-7M9 17v-7M13 17v-7M17 17v-7M21 17v-7" />
      <path d="M3 10h18" />
    </>
  )}
  {name === 'grill' && (
    <>
      <path d="M4 6h16l-2 8H6L4 6z" />
      <path d="M8 14v6M16 14v6" />
      <path d="M9 3c0 1-1 2-1 3M13 3c0 1-1 2-1 3" />
    </>
  )}
  {name === 'mountain' && (
    <>
      <path d="M3 19l6-10 4 6 3-4 5 8H3z" />
      <circle cx="17" cy="6" r="1.5" />
    </>
  )}
  {name === 'wifi' && (
    <>
      <path d="M2 9c4-4 16-4 20 0M5 12c3-3 11-3 14 0M8 15c2-2 6-2 8 0" />
      <circle cx="12" cy="19" r="1" />
    </>
  )}
  {name === 'tv' && (
    <>
      <rect x="3" y="5" width="18" height="12" rx="1" />
      <path d="M9 21h6" />
    </>
  )}
  {name === 'thermostat' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5l3 2" />
    </>
  )}
  {name === 'laundry' && (
    <>
      <rect x="4" y="3" width="16" height="18" rx="1" />
      <circle cx="12" cy="13" r="5" />
      <circle cx="8" cy="6" r="0.5" fill="currentColor" />
    </>
  )}
  {name === 'wave' && (
    <path d="M3 12c4-6 14-6 18 0M3 12c4 6 14 6 18 0" />
  )}
  {name === 'golf' && (
    <>
      <path d="M12 3v15" />
      <path d="M12 5l6 2-6 2" />
      <ellipse cx="12" cy="20" rx="5" ry="1.5" />
    </>
  )}
  {name === 'star' && (
    <path d="M12 2l3 7h7l-5.5 4.5L18 21l-6-4-6 4 1.5-7.5L2 9h7z" />
  )}
  {name === 'barn' && (
    <>
      <path d="M3 21V9l9-6 9 6v12" />
      <path d="M9 21v-6h6v6M3 13h18" />
    </>
  )}
  {name === 'arrow-right' && (
    <path d="M5 12h14M13 6l6 6-6 6" />
  )}
</svg>
