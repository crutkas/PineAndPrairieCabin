---
import { owner } from '../data/owner';
---
<section class:list={['owner-bio', owner.photo ? 'with-photo' : 'no-photo']}>
  <div class="owner-inner">
    <div class="owner-copy">
      <div class="label">From Our Family</div>
      <h2 class="display reveal">{owner.greeting}</h2>
      <div class="body reveal">
        {owner.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="signature">
        <span>{owner.signature}</span>
        <strong>{owner.firstName}</strong>
      </div>
    </div>

    {owner.photo && (
      <figure class="owner-photo reveal">
        <img src={owner.photo} alt={`${owner.firstName} of Pine & Prairie Cabin`} loading="lazy" />
      </figure>
    )}
  </div>
</section>

<style>
  .owner-bio {
    background: var(--bg);
    padding: var(--section-y) var(--gutter-x);
  }

  .owner-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .with-photo .owner-inner {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(48px, 7vw, 96px);
    align-items: center;
  }

  .no-photo .owner-inner {
    max-width: 720px;
  }

  .label {
    margin-bottom: 22px;
  }

  h2.display {
    font-family: var(--display);
    font-size: clamp(36px, 5vw, 56px);
    font-style: italic;
    font-weight: 300;
    line-height: 1.15;
    margin: 0 0 28px;
  }

  .body {
    max-width: 56ch;
  }

  .body p {
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 18px;
    line-height: 1.75;
    margin: 0;
    max-width: 56ch;
  }

  .body p + p {
    margin-top: 20px;
  }

  .signature {
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 14px;
    font-style: italic;
    line-height: 1.5;
    margin-top: 36px;
    padding-top: 24px;
  }

  .signature strong {
    color: var(--ink);
    display: block;
    font-family: var(--display);
    font-size: 28px;
    font-style: italic;
    font-weight: 300;
    line-height: 1.1;
    margin-top: 4px;
  }

  .owner-photo {
    margin: 0;
  }

  .owner-photo img {
    aspect-ratio: 5 / 6;
    border-radius: 4px;
    box-shadow: 0 22px 60px rgba(28, 28, 28, 0.12);
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  @media (max-width: 880px) {
    .with-photo .owner-inner {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }
</style>
