---
import { site } from '../data/site';
---
<section class="booking" id="book">
  <div class="reveal">
    <div class="label">Reservations</div>
    <h2 class="display">Check availability.</h2>
    <p class="lede">Pine &amp; Prairie Cabin is booked through Suncadia's vacation rental program. View the calendar, see seasonal rates, and reserve your stay directly on the resort site.</p>
    <div class="actions">
      <a class="btn light" href={site.bookingUrl} target="_blank" rel="noopener">Book on Suncadia →</a>
      <a class="btn ghost-light" href={`mailto:${site.email}?subject=Inquiry about Pine %26 Prairie Cabin&body=Hi%2C%0A%0AI'm looking at the following dates%3A%0A%0AGroup size%3A%0AAny questions%3A%0A%0AThanks!`}>Ask a Question</a>
    </div>
    <div class="meta">
      <strong>Reservations</strong> · <a href={`tel:${site.bookingPhoneTel}`}>{site.bookingPhone}</a>
      <span class="sep">·</span>
      <strong>Check-in</strong> 4 PM
      <span class="sep">·</span>
      <strong>Check-out</strong> 11 AM
      <span class="sep">·</span>
      <strong>Pets</strong> Not permitted
    </div>
  </div>
</section>

<style>
  .booking {
    background: var(--ink);
    color: var(--light-ink);
    text-align: center;
    padding: 140px var(--gutter-x);
  }
  .booking .label { color: rgba(247, 243, 236, 0.65); }
  .booking h2 { color: var(--light-ink); }
  .booking p.lede { color: rgba(247, 243, 236, 0.78); margin: 0 auto 48px; }
  .booking .actions { display: flex; justify-content: center; gap: 24px; flex-wrap: wrap; margin-bottom: 56px; }
  .booking .btn.light:hover { background: var(--terracotta); color: var(--light-ink); border-color: var(--terracotta); }
  .meta { font-size: 12px; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(247, 243, 236, 0.55); line-height: 2.2; }
  .meta strong { color: rgba(247, 243, 236, 0.92); font-weight: 500; }
  .meta a { color: inherit; text-decoration: none; border-bottom: 1px solid rgba(247, 243, 236, 0.3); }
  .meta a:hover { color: var(--light-ink); border-bottom-color: var(--light-ink); }
  .meta .sep { color: rgba(247, 243, 236, 0.3); margin: 0 8px; }

  @media (max-width: 760px) {
    .booking { padding: 96px var(--gutter-x); }
    .meta { font-size: 10px; letter-spacing: 0.16em; }
    .meta .sep { display: block; visibility: hidden; height: 4px; }
  }
</style>
