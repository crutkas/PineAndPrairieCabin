---
import { reviews } from '../data/reviews';
---

<section class="reviews">
  <div class="inner">
    <div class="label">From Recent Guests</div>
    <h2 class="display">Words <em>better</em> than ours.</h2>
    <div class="grid">
      {reviews.map((review) => (
        <article class="quote reveal">
          <span class="mark" aria-hidden="true">“</span>
          <p>{review.text}</p>
          <div class="attribution">{review.attribution}</div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .reviews {
    background: var(--bg);
    padding: var(--section-y) var(--gutter-x);
  }

  .inner {
    margin: 0 auto;
    max-width: 1200px;
  }

  .label {
    margin-bottom: 18px;
    text-align: center;
  }

  h2.display {
    font-family: var(--display);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 300;
    line-height: 1.08;
    margin: 0;
    text-align: center;
  }

  h2.display em {
    font-style: italic;
  }

  .grid {
    display: grid;
    gap: clamp(40px, 5vw, 80px);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: clamp(48px, 6vw, 72px);
  }

  .quote {
    position: relative;
  }

  .quote:nth-child(2) { transition-delay: 180ms; }
  .quote:nth-child(3) { transition-delay: 260ms; }
  .quote:nth-child(4) { transition-delay: 340ms; }
  .quote:nth-child(5) { transition-delay: 420ms; }

  .mark {
    color: var(--terracotta);
    font-family: var(--display);
    font-size: 120px;
    left: -16px;
    line-height: 1;
    opacity: 0.4;
    position: absolute;
    top: -42px;
  }

  .quote p {
    color: var(--ink);
    font-family: var(--display);
    font-size: clamp(20px, 1.7vw, 26px);
    font-style: italic;
    font-weight: 300;
    line-height: 1.45;
    margin: 0;
    position: relative;
    z-index: 1;
  }

  .attribution {
    border-top: 1px solid var(--line);
    color: var(--ink-mute);
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.26em;
    line-height: 1.5;
    margin-top: 24px;
    padding-top: 16px;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .mark {
      left: -10px;
    }
  }
</style>
