---
import { bedrooms, motherInLawSuite } from '../data/bedrooms';
---
<section class="block" id="bedrooms">
  <div class="wrap">
    <div class="head reveal">
      <div class="label">Sleeping</div>
      <h2 class="display" style="margin:0;">Three bedrooms.<br/>A Mother-in-Law suite.<br/>Sleeps eleven.</h2>
    </div>

    <div class="bed-grid">
      {bedrooms.map((b, idx) => (
        <article class="bed reveal">
          <div class="bed-img-wrap">
            <img src={b.image} alt={b.name} loading="lazy" />
            <span class="bed-no">{String(idx + 1).padStart(2, '0')}</span>
          </div>
          <div class="bed-body">
            <h3>{b.name}</h3>
            <p class="bed-bed">{b.bed}</p>
            {b.notes && <p class="bed-notes">{b.notes}</p>}
          </div>
        </article>
      ))}
    </div>

    <article class="suite reveal">
      <div class="suite-img-wrap">
        <img src={motherInLawSuite.image} alt={motherInLawSuite.name} loading="lazy" />
        <span class="suite-tag">For the Family</span>
      </div>
      <div class="suite-body">
        <div class="label" style="margin-bottom: 12px;">Above the Garage</div>
        <h3>{motherInLawSuite.name}</h3>
        <p class="bed-bed">{motherInLawSuite.bed}</p>
        {motherInLawSuite.notes && <p class="suite-notes">{motherInLawSuite.notes}</p>}
      </div>
    </article>
  </div>
</section>

<style>
  .head { margin-bottom: 64px; }
  .bed-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
  }
  .bed { display: flex; flex-direction: column; }
  .bed-img-wrap {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--bg-elevated);
  }
  .bed img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 600ms ease;
  }
  .bed:hover img { transform: scale(1.03); }
  .bed-no {
    position: absolute;
    top: 18px; left: 18px;
    font-family: var(--display);
    font-size: 28px;
    font-weight: 300;
    color: var(--light-ink);
    text-shadow: 0 2px 8px rgba(0,0,0,0.3);
  }
  .bed-body { padding: 24px 0 0; }
  .bed h3, .suite h3 {
    font-family: var(--display);
    font-weight: 400;
    font-size: 26px;
    margin: 0 0 6px;
    line-height: 1.1;
  }
  .bed-bed {
    font-size: 13px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--forest);
    margin: 0 0 8px;
    font-weight: 500;
  }
  .bed-notes {
    font-size: 14px;
    color: var(--ink-soft);
    margin: 0;
  }

  /* Featured Mother-in-Law suite card — wider, asymmetric, sits below the 3-bedroom grid */
  .suite {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 56px;
    margin-top: 72px;
    padding-top: 56px;
    border-top: 1px solid var(--line);
    align-items: center;
  }
  .suite-img-wrap {
    position: relative;
    aspect-ratio: 5 / 4;
    overflow: hidden;
  }
  .suite img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 600ms ease;
  }
  .suite:hover img { transform: scale(1.02); }
  .suite-tag {
    position: absolute;
    top: 18px; left: 18px;
    background: var(--terracotta);
    color: var(--light-ink);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    padding: 6px 14px;
    font-weight: 500;
  }
  .suite-body h3 { font-size: 36px; margin-bottom: 12px; }
  .suite-notes {
    font-size: 16px;
    color: var(--ink-soft);
    line-height: 1.7;
    margin: 16px 0 0;
    max-width: 48ch;
  }

  @media (max-width: 880px) {
    .bed-grid { grid-template-columns: 1fr; gap: 32px; }
    .suite { grid-template-columns: 1fr; gap: 28px; margin-top: 48px; padding-top: 40px; }
    .suite-body h3 { font-size: 30px; }
  }
</style>
